# LLM provider: groq | gemini
LLM_PROVIDER=gemini

# Gemini (https://ai.google.dev/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq (https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional paths
# CATALOG_PATH=shl_product_catalog.json
# DATA_DIR=data

# Request limits (PDF: 8 turns per conversation, 30s per /chat call)
# MAX_CONVERSATION_TURNS=8
# CHAT_REQUEST_TIMEOUT_SECONDS=30
# LLM_REQUEST_TIMEOUT_SECONDS=25
# LLM_TEMPERATURE=0

# Build artifacts (run once after catalog changes, or at Docker/Render deploy):
# python scripts/build_index.py
# python scripts/build_groups.py --skip-llm
